# ---------------------------------------------------------------------------
# Web app (apps/web) — copy the relevant lines to apps/web/.env.local
# NEXT_PUBLIC_* values are embedded in browser JavaScript: NEVER put secrets here.
# ---------------------------------------------------------------------------

# Market data source for the browser. Phase 1–2 supports only "mock" (simulated data).
# Phase 5 adds "api" (live data via our backend).
NEXT_PUBLIC_MARKET_DATA_SOURCE=mock
# NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# API server (apps/api) — Phase 4+. Server-side only; never expose to the browser.
# ---------------------------------------------------------------------------

# PORT=4000
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:3000
# DATABASE_URL=postgresql://trading:trading@localhost:5432/trading_dashboard
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=change-me-to-a-long-random-string

# Market data provider: mock | fyers | kite   (see docs/MARKET_DATA_PROVIDERS.md)
# MARKET_DATA_PROVIDER=mock

# FYERS API v3
# FYERS_APP_ID=
# FYERS_SECRET_KEY=
# FYERS_REDIRECT_URI=http://localhost:4000/api/auth/fyers/callback

# Zerodha Kite Connect v3
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_REDIRECT_URI=http://localhost:4000/api/auth/kite/callback
